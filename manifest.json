{
  "name": "GoogleClassroom カスタム",
  "description": "GoogleClassroomを改造し、使いやすくします",
  "version": "0.0.1",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*"
      ],
      "js": [
        "utils.js",
        "script.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "options_page": "option.html"
}